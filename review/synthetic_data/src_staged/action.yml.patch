##
## action.yml additions for the two new operations.
## Append these two top-level input groups + operation branches alongside the
## other generate-* operations in the existing action.yml.  Keep the same
## input-naming style (kebab-case under `inputs:`).
##

inputs:

  # ─── generate-synthetic-data-from-sml ────────────────────────────────────
  fingerprint:
    description: "Path to a precomputed fingerprint YAML (preferred path; no real data is touched)."
    required: false

  sml:
    description: "Path to an SML model directory to profile against the supplied connection (experimental path)."
    required: false

  output-dir:
    description: "Directory where synthetic CSVs and artifacts are written."
    required: false

  dialect:
    description: "SQL dialect for emitted DDL/INSERT statements: ansi | postgres | snowflake | mysql | bigquery."
    required: false
    default: "ansi"

  seed:
    description: "Deterministic PRNG seed (mulberry32). Same seed → identical output."
    required: false
    default: "1742832000"

  max-rows-per-table:
    description: "Optional per-table row cap (smoke tests). 0 = uncapped."
    required: false
    default: "0"

  acknowledge-experimental:
    description: "Acknowledge experimental status (required until TSTR certification completes)."
    required: false
    default: "false"

  # ─── generate-synthetic-data-from-connection ─────────────────────────────
  target-schema:
    description: "Target schema where synthetic tables will be materialized."
    required: false

  batch-size:
    description: "Rows per multi-value INSERT when writing to a connection."
    required: false
    default: "500"

  drop-if-exists:
    description: "Drop facts then dimensions before create (FK-safe)."
    required: false
    default: "false"

  report-dir:
    description: "Directory for the pipeline-isolation + manifest reports emitted by the connection path."
    required: false
    default: "synthetic_data_reports"

