{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/operations/generate-powerbi-from-namespace/**",
    // Tests are run by vitest, which transpiles them itself. Excluding them keeps
    // them out of the published dist/ and lets them import from vscode-extension/,
    // which `rootDir: "src"` would otherwise reject.
    "src/**/__tests__/**"
  ]
}
