{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.5.0/schema.json",
  "name": "<%= visualName %>",
  "position": {
    "x": 10,
    "y": 0,
    "z": 0,
    "height": 280,
    "width": 280,
    "tabOrder": 0
  },
  <%=
    if (worksheet.graphType == 'bar') { 
      const measure = worksheet.xAxis;
      const level = worksheet.yAxis;
    }
    else {
      const measure = worksheet.yAxis;
      const level = worksheet.xAxis;
    }
    Object.entries(model.mdx.attributes).forEach((dimensionName, dimension: any) => {
      Object.entries(dimension).forEach((hierarchyName, hierarchy: any) => {
        for (const attribute of hierarchy) {
          if (attribute.queryName == level) {
            const dimension = dimensionName;
            const hierarchy = hierarchyName;
          };
        };
      });
    });
  %>
  "visual": {
    "visualType": "<%= visualType %>",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "HierarchyLevel": {
                  "Expression": {
                    "Hierarchy": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "<%= dimension %>"
                        }
                      },
                      "Hierarchy": "<%= hierarchy %>"
                    }
                  },
                  "Level": "<%= level %>"
                }
              },
              "queryRef": "<%= dimension %>.<%= hierarchy %>.<%= level %>",
              "nativeQueryRef": "<%= hierarchy %> <%= level %>",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "CubeMeasures"
                    }
                  },
                  "Property": "<%= measure %>"
                }
              },
              "queryRef": "CubeMeasures.<%= measure %>",
              "nativeQueryRef": "<%= measure %>"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "CubeMeasures"
                  }
                },
                "Property": "<%= measure %>"
              }
            },
            "direction": "Descending"
          }
        ],
        "isDefaultSort": true
      }
    },
    "drillFilterOtherVisuals": true
  },
  "filterConfig": {
    "filters": [
      {
        "name": "bf50da0a4cc3866d59ea",
        "field": {
          "Measure": {
            "Expression": {
              "SourceRef": {
                "Entity": "CubeMeasures"
              }
            },
            "Property": "<%= measure %>"
          }
        },
        "type": "Advanced"
      },
      {
        "name": "855061c636a2fd0f74c8",
        "field": {
          "HierarchyLevel": {
            "Expression": {
              "Hierarchy": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "<%= dimension %>"
                  }
                },
                "Hierarchy": "<%= hierarchy %>"
              }
            },
            "Level": "<%= level %>"
          }
        },
        "type": "Categorical"
      }
    ]
  }
}
