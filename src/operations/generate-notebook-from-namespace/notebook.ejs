{
 "cells": [
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "de0962f8",
   "metadata": {},
   "outputs": [],
   "source": [
    <%if (connection.installer) { %>
    "pip install \"atscale < 3\""
    <% } else { %>
    "pip install \"atscale\""
    <% } %>
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3b31027d",
   "metadata": {},
   "outputs": [],
   "source": [
    "from atscale.client import Client\n",
    <% if (connection.installer) { %>
    "from atscale.project import Project\n",
    <% } else { %>
    "from atscale.repo import Repo\n",
    "from atscale.catalog import Catalog\n",
    <% } %>
    "from atscale.data_model import DataModel\n",
    "import plotly.express as px"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e127156a",
   "metadata": {},
   "outputs": [],
   "source": [
    "client = Client(\n",
    "    server=\"<%= connection.mdx.url %>\"\n",
         <% if (connection.installer) { %>
    "    organization=\"<%= connection.mdx.organization_id %>\",\n",
         <% } %>
    "    username=\"<%= mdxUser.username %>\",\n",
    "    password=\"<%= mdxUser.password %>\",\n",
    ")\n",
    "client.connect()"
   ]
  },
  <% if (connection.installer) { %>
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6b97b362",
   "metadata": {},
   "outputs": [],
   "source": [
    "project = client.select_project()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d2aba933",
   "metadata": {},
   "outputs": [],
   "source": [
    "data_model = project.select_data_model()"
   ]
  },
  <% } else { %>
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6b97b362",
   "metadata": {},
   "outputs": [],
   "source": [
    "repo = client.select_repo()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fe8fb119",
   "metadata": {},
   "outputs": [],
   "source": [
    "catalog = repo.select_catalog()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d2aba933",
   "metadata": {},
   "outputs": [],
   "source": [
    "data_model = catalog.select_data_model()"
   ]
  },
  <% } %>
  <% Object.entries(namespace.worksheets).forEach(([worksheetName, worksheet]) => { %>
     {
       "cell_type": "code",
       "execution_count": null,
       "id": "0db9d42a",
       "metadata": {},
       "outputs": [],
       "source": [
        <% if (worksheet.graphType == "text") { %>
          "df = data_model.get_data(feature_list=[<%= worksheet.measures %>])\n",
          "print(df)"
        <% } else if (worksheet.graphType == "line") { %>
          "df = data_model.get_data(feature_list=[\"<%= worksheet.xAxis %>\", \"<%= worksheet.yAxis %>\"])\n",
          "fig = px.line(df, x=\"<%= worksheet.xAxis %>\", y=\"<%= worksheet.yAxis %>\", title=\"<%= worksheet.title %>\")\n",
          "fig.show()"
        <% } else if (worksheet.graphType == "bar") { %>
          "df = data_model.get_data(feature_list=[\"<%= worksheet.xAxis %>\", \"<%= worksheet.yAxis %>\"])\n",
          "fig = px.bar(df, x=\"<%= worksheet.xAxis %>\", y=\"<%= worksheet.yAxis %>\", title=\"<%= worksheet.title %>\")\n",
          "fig.show()"
        <% } %>
       ]
     },
  <% }) %>
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7aa6263c",
   "metadata": {},
   "outputs": [],
   "source": []
  }
 ]
}