global:
  ingressDomain: "<%= hostname %>"

  atscale:
    logLevel: "INFO"
    registry:
      url: docker.io
      apiKey: ""

    tls:
      tlsCrt: "<%= tlsCrt %>"
      tlsKey: "<%= tlsKey %>"
<% if (licenseKey) { %>
atscale-entitlement:
  entitlement:
    licenseKey: "<%= licenseKey %>"
<% } %>
atscale-mcp:
  enabled: <%= enableMcp %>
