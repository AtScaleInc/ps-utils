      <column aggregation='CountD' caption='Customer Count' datatype='integer' default-format='n' name='[customercount1]' role='measure' type='quantitative' />
      <column aggregation='CountD' caption='Estimated Customer Count' datatype='integer' default-format='n' name='[customercountestimate1]' role='measure' type='quantitative' />
      <column caption='City' datatype='string' name='[d_city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column caption='First Name' datatype='string' name='[d_firstname]' role='dimension' type='nominal' />
      <column caption='Last Name' datatype='string' name='[d_lastname]' role='dimension' type='nominal' />
      <column caption='Postal Code' datatype='string' name='[d_postalcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='nominal' />
      <column caption='Product Subcategory ID' datatype='integer' name='[d_productsubcategoryId]' role='dimension' type='ordinal'>
        <desc>
          <formatted-text>
            <run>ID of the product category</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Order' datatype='string' name='[order]' role='dimension' type='nominal' />
      <column caption='Order Line Item' datatype='string' name='[order_line_item]' role='dimension' type='nominal'>
        <desc>
          <formatted-text>
            <run>Order Line Item</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Order Quantity' datatype='integer' default-format='n' name='[orderquantity1]' role='measure' type='quantitative' />
      <column caption='Sales Amount' datatype='real' default-format='n$#,##0.00' name='[salesamount1]' role='measure' type='quantitative' />
      <column caption='Order Month Label' datatype='string' name='[Calculation_1001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='RAWSQL_STR(&quot;date_format(%1, &apos;yyyy-MM&apos;)&quot;, [Order Month])' />
      </column>
      <column caption='Safe Sales' datatype='real' name='[Calculation_1002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RAWSQLAGG_REAL(&quot;sum(nvl(%1, 0))&quot;, [salesamount1])' />
      </column>
      <column caption='Product Line Code' datatype='string' name='[Calculation_1003]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='RAWSQL_STR(&quot;regexp_extract(%1, &apos;^([A-Z]+)&apos;, 1)&quot;, [Product Line])' />
      </column>
      <column caption='Sales per Line Code (FIXED)' datatype='real' name='[Calculation_1004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Calculation_1003] : SUM([salesamount1])}' />
      </column>
      <column caption='Portable Quantity' datatype='integer' name='[Calculation_1005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RAWSQL_INT(&quot;coalesce(%1, 0)&quot;, [orderquantity1])' />
      </column>
      <column caption='Days Since Order Month' datatype='integer' name='[Calculation_1006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, DATE([Order Month]), TODAY())' />
      </column>
      <column caption='Order Type' datatype='string' name='[typeorder]' role='dimension' type='nominal' />
