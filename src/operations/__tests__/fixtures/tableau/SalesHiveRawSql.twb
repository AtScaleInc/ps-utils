    <datasource caption='Custom SQL Source' inline='true' name='federated.customsql01' version='10.5'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='AtScale Hive' name='hadoophive.customsql01'>
            <connection authentication='yes' authentication-type='3' class='hadoophive' connection-type='2' dbname='' odbc-connect-string-extras='DisableLimitZero=1;ssl=0' one-time-sql='' port='11111' server='atscale.example.com' sslcert='' sslmode='' tablename='' transport-type='1' username='my_user' />
          </named-connection>
        </named-connections>
        <relation connection='hadoophive.customsql01' name='Custom SQL Query' type='text'>SELECT `product line`, nvl(salesamount, 0) AS sales
FROM `sales insights`.`internet sales cube`
WHERE `product line` &lt;=&gt; 'Road'</relation>
      </connection>
    </datasource>
