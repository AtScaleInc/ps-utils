#!/usr/bin/env sh

set -eu

# Resolve all symlinks so SCRIPT_DIR is the real package directory even when
# invoked via a global npm bin symlink (e.g. /usr/local/bin/atscale-utils →
# /usr/local/lib/node_modules/@atscale-ps/ps-utils/atscale-utils → real path).
_resolve_script() {
  _p="$1"
  while [ -L "$_p" ]; do
    _d="$(cd "$(dirname "$_p")" && pwd)"
    _p="$(readlink "$_p")"
    case "$_p" in /*) ;; *) _p="$_d/$_p" ;; esac
  done
  echo "$(cd "$(dirname "$_p")" && pwd)"
}

SCRIPT_DIR="$(_resolve_script "$0")"

show_completion_usage() {
  echo "Usage: $0 --completion {bash|zsh|fish}" >&2
}

install_completion() {
  shell="$1"
  case "$shell" in
    bash)
      target_dir="$HOME/.bash_completion.d"
      target_file="$target_dir/atscale-utils"
      mkdir -p "$target_dir"
      "$SCRIPT_DIR/atscale-utils" --print-completion bash > "$target_file"
      echo "Installed bash completions to $target_file"
      echo "To enable in this session: source $target_file"
      ;;
    zsh)
      target_dir="$HOME/.zsh/completions"
      target_file="$target_dir/_atscale-utils"
      mkdir -p "$target_dir"
      "$SCRIPT_DIR/atscale-utils" --print-completion zsh > "$target_file"
      echo "Installed zsh completions to $target_file"
      echo "To enable in this session: fpath=($target_dir $fpath) && autoload -Uz compinit && compinit"
      ;;
    fish)
      target_dir="$HOME/.config/fish/completions"
      target_file="$target_dir/atscale-utils.fish"
      mkdir -p "$target_dir"
      "$SCRIPT_DIR/atscale-utils" --print-completion fish > "$target_file"
      echo "Installed fish completions to $target_file"
      echo "To enable in this session: source $target_file"
      ;;
    *)
      show_completion_usage
      exit 1
      ;;
  esac
}

needs_build() {
  [ ! -d "$SCRIPT_DIR/src" ] && return 1
  [ ! -f "$SCRIPT_DIR/dist/cli.js" ] && return 0
  [ -n "$(find "$SCRIPT_DIR/src" "$SCRIPT_DIR/resources" "$SCRIPT_DIR/package.json" "$SCRIPT_DIR/tsconfig.json" -newer "$SCRIPT_DIR/dist/cli.js" 2>/dev/null | head -1)" ] && return 0
  return 1
}

if [ "${ATSCALE_SKIP_BUILD:-0}" != "1" ] && needs_build; then
  (cd "$SCRIPT_DIR" && [ ! -d node_modules ] && npm install; npm run build)
fi

if [ "$#" -ge 1 ] && [ "$1" = "--completion" ]; then
  if [ "$#" -ne 2 ]; then
    show_completion_usage
    exit 1
  fi
  install_completion "$2"
  exit 0
fi

if [ "$#" -ge 1 ] && [ "$1" = "--print-completion" ]; then
  if [ "$#" -ne 2 ]; then
    show_completion_usage
    exit 1
  fi
  case "$2" in
    bash)
      cat "$SCRIPT_DIR/scripts/resources/completions/atscale-utils.bash"
      ;;
    zsh)
      cat "$SCRIPT_DIR/scripts/resources/completions/atscale-utils.zsh"
      ;;
    fish)
      cat "$SCRIPT_DIR/scripts/resources/completions/atscale-utils.fish"
      ;;
    *)
      show_completion_usage
      exit 1
      ;;
  esac
  exit 0
fi

node "$SCRIPT_DIR/dist/cli.js" "$@"
