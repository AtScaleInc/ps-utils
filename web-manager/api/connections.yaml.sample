# connections.yaml.sample
# Copy to api/connections.yaml (gitignored). The Settings screen reads and writes
# this file; you rarely need to edit it by hand.
#
# Business units are isolated realms: each has its own Git profile and its own
# hosts. Each AtScale host is one connection with a ps-utils-style `atscale:`
# block, plus its business unit (bu) and group (env: dev | test | qa | prod).
# Hosts are containers: `url` is always https://<hostname>, no port.

businessUnits:
  sales:
    label: Sales Analytics
    # This BU's Git profile. PAT needs `repo` scope.
    git:
      username: your_github_username
      email: you@company.com
      token: ghp_your_personal_access_token

connections:
  dev-east:
    bu: sales
    env: dev
    label: dev-east
    status: untested
    lastChecked: null
    atscale:
      url: https://dev-atscale-01.corp.local
      username: svc_atscale_dev      # Keycloak user - required for deploy (cookie login)
      password: your_password
      apiToken: ''                    # optional
      insecure: true                  # skip TLS verification (self-signed certs)
    links: []                         # repo/branch/model linked through this app
