{
  "name": "operation-cli",
  "version": "0.1.0",
  "description": "CLI framework with operations and required parameters",
  "type": "module",
  "bin": {
    "operation-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "action.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-ejs.mjs && npm run generate:completions",
    "start": "npm run build && node dist/cli.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "generate:completions": "node dist/scripts/generate-completions.js"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "pg": "^8.20.0",
    "snowflake-sdk": "^2.3.6",
    "xml2js": "^0.6.2",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "@types/xml2js": "^0.4.14",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
